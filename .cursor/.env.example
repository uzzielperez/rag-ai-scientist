# Copy to .env and fill values as needed.
# query_analysis_knowledge uses GROQ_API_KEY when available.
# OPENAI_API_KEY is optional and reserved for optional integrations.

GROQ_API_KEY=gsk_your-key-here
# OPENAI_API_KEY=sk-your-key-here

